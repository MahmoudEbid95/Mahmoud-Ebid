{
  "name": "ME Kali Cloud Desktop",
  "image": "kalilinux/kali-rolling",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "codespaces",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "ME Kali Desktop",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
